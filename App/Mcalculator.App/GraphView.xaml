<UserControl x:Class="Mcalculator.App.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
            BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Canvas x:Name="Surface" ClipToBounds="True" Background="Transparent"
                MouseLeftButtonDown="Surface_MouseDown" MouseLeftButtonUp="Surface_MouseUp"
                MouseMove="Surface_MouseMove" MouseWheel="Surface_Wheel"
                SizeChanged="Surface_SizeChanged" />
    </Border>
</UserControl>
