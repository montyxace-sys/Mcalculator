<UserControl x:Class="Mcalculator.App.Panels"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Unidades -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="UNIDADES" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />

                <ComboBox x:Name="CategoryBox" Grid.Row="1" Margin="0,0,0,10" Height="30"
                          SelectionChanged="Category_Changed" />

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AmountBox" Grid.Column="0" Style="{StaticResource FlatTextBox}" Height="32"
                             Background="{StaticResource Surface2Brush}" Padding="10,0"
                             TextChanged="Amount_Changed" />
                    <ComboBox x:Name="FromBox" Grid.Column="2" Height="30" SelectionChanged="Unit_Changed" />
                </Grid>

                <TextBlock Grid.Row="3" Text="a" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />

                <Grid Grid.Row="4">
                    <ComboBox x:Name="ToBox" Height="30" SelectionChanged="Unit_Changed" />
                </Grid>

                <TextBlock x:Name="ResultText" Grid.Row="5" Text="—" FontSize="26" FontWeight="Light"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"
                           VerticalAlignment="Top" Margin="0,14,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Programador -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="PROGRAMADOR" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />

                <TextBox x:Name="HexBox" Style="{StaticResource FlatTextBox}" Height="30" Margin="0,0,0,6"
                         Background="{StaticResource Surface2Brush}" Padding="10,0" TextChanged="Base_Changed" />
                <TextBox x:Name="DecBox" Style="{StaticResource FlatTextBox}" Height="30" Margin="0,0,0,6"
                         Background="{StaticResource Surface2Brush}" Padding="10,0" TextChanged="Base_Changed" />
                <TextBox x:Name="OctBox" Style="{StaticResource FlatTextBox}" Height="30" Margin="0,0,0,6"
                         Background="{StaticResource Surface2Brush}" Padding="10,0" TextChanged="Base_Changed" />
                <TextBox x:Name="BinBox" Style="{StaticResource FlatTextBox}" Height="30" Margin="0,0,0,6"
                         Background="{StaticResource Surface2Brush}" Padding="10,0" TextChanged="Base_Changed" />

                <TextBlock x:Name="BaseHint" Text="Escribe en cualquier base y las demás se actualizan."
                           Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
