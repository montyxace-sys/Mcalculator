<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Mcalculator</AssemblyName>
    <RootNamespace>Mcalculator.App</RootNamespace>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <Company>MSoft</Company>
    <Product>Mcalculator</Product>
    <Description>Calculadora científica, gráfica y programable</Description>
    <ApplicationIcon>Assets\mcalculator.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Mcalculator.Core\Mcalculator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Theme.xaml" />
    <Resource Include="Assets\mcalculator.ico" />
    <Resource Include="Assets\logo.png" />
    <Content Include="Assets\mcalculator.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
